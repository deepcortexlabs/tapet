{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["packages/*/src", "packages/*/test", "e2e", "playwright.config.ts"],
  // Code that runs in the window (renderer and preload) is checked by svelte-check (packages/app/tsconfig.web.json).
  "exclude": ["packages/app/src/renderer", "packages/app/src/preload"]
}
