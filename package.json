{
  "name": "tapet-workspace",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @tapet/app build",
    "package": "pnpm build && node packages/cli/build.ts",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc && tsc -p bench/graph && pnpm --filter @tapet/app check",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "pnpm build && playwright test",
    "site": "node site/build.ts"
  },
  "devDependencies": {
    "@cosmos.gl/graph": "^3.5.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0"
}
